notice-violation = {$user}, it looks like your message {$reason}. You can't write here for {$duration}.
notice-reason-spam = looks like spam
notice-reason-ads = looks like advertising
notice-reason-insult = contains insults
notice-duration-forever = forever
notice-duration-minutes = {$minutes ->
    [one] {$minutes} minute
   *[other] {$minutes} minutes
}
notice-duration-hours = {$hours ->
    [one] {$hours} hour
   *[other] {$hours} hours
}
notice-duration-days = {$days ->
    [one] {$days} day
   *[other] {$days} days
}
